# API Configuration
# Copy this file to .env and update with your actual values

# Your backend API URL (use your local IP address, not localhost when using Expo Go)
# Example: http://192.168.1.100:5500/api/v1
API_BASE_URL=http://localhost:5500/api/v1

# Your tenant ID from the backend
TENANT_ID=your-tenant-id-here

# API timeout in milliseconds
API_TIMEOUT=30000
